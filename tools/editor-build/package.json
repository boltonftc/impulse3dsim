{
  "name": "impulse-editor-build",
  "private": true,
  "type": "module",
  "description": "Build-time only: bundles CodeMirror 6 into a single self-contained file for GitHub Pages. Not shipped.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --minify --legal-comments=none --outfile=../../web/vendor/codemirror.bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@codemirror/commands": "^6.5.0",
    "@codemirror/language": "^6.10.1",
    "@codemirror/autocomplete": "^6.16.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/lint": "^6.7.0",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2"
  }
}
