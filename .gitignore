# Build outputs (regenerated by tools/build.ps1 and course/build_course.py).
# The *served* copies under web/ (app.jar, shim.jar, course.json, lessons/) are
# intentionally committed so GitHub Pages can serve the site with no build step.
/build/

# Experiments and scratch — not part of the shippable site.
/spikes/
/tmp_extract/
/tmp_*.png

# Bundled toolchains / dependencies (developers install their own).
/tools/node/
**/node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# CheerpJ self-host mirror: keep the runtime files, drop only in-flight temp files.
/web/cj/**/*.part

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
